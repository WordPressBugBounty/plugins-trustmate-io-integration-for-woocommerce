# Menu
msgid "Create TrustMate account"
msgstr "Vytvořit účet TrustMate"

msgid "Settings"
msgstr "Nastavení"

msgid "Widgets"
msgstr "Widgety"

# Headers and buttons
msgid "settings"
msgstr "nastavení"

msgid "Configure plugin"
msgstr "Nastavit plugin"

msgid "If you already have TrustMate account"
msgstr "Pokud již máte TrustMate účet"

msgid "skip this step"
msgstr "přeskočit tento krok"

