# Config form
msgid ""
"Your TrustMate user code (UUID from TrustMate panel, Integration section)"
msgstr ""
"Votre code utilisateur TrustMate (UUID du panneau TrustMate, section "
"Intégration)"

msgid "Additional TrustMate account UUIDs per language"
msgstr "UUIDs de compte TrustMate supplémentaires par langue"

msgid "Use this only if you have multiple TrustMate language accounts"
msgstr ""
"Utilisez ceci uniquement si vous avez plusieurs comptes linguistiques "
"TrustMate"

