msgid "Show sliding out widget with shop's grade"
msgstr "Toon uitschuifbare widget met winkelcijfers"

msgid "Non-invasive badge is glued to screen's edge and takes little space"
msgstr ""
"Niet-invasieve badge wordt op de rand van het scherm geplakt en neemt weinig "
"ruimte in beslag"

msgid "Click shows a modal with recent reviews"
msgstr "Klik toont een modal met recente beoordelingen"

msgid "You can change display position in TrustMate panel"
msgstr "U kunt de weergavepositie in het TrustMate-paneel wijzigen"

msgid "Why use it?"
msgstr "Waarom gebruiken?"

msgid "sales increase"
msgstr "omzetstijging"

msgid "customers do not leave site searching for reviews"
msgstr "klanten verlaten de site niet op zoek naar beoordelingen"

msgid "can boost your SEO"
msgstr "kan uw SEO een boost geven"

msgid "can make search engines show stars under your results"
msgstr "kan ervoor zorgen dat zoekmachines sterren tonen onder uw resultaten"

