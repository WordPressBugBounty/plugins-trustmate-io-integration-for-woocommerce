# Menu
msgid "Create TrustMate account"
msgstr "Ustvarite račun TrustMate"

msgid "Settings"
msgstr "Nastavitve"

msgid "Widgets"
msgstr "Gradniki"

# Headers and buttons
msgid "settings"
msgstr "nastavitve"

msgid "Configure plugin"
msgstr "Konfiguracija vtičnika"

msgid "If you already have TrustMate account"
msgstr "Če že imate račun TrustMate"

