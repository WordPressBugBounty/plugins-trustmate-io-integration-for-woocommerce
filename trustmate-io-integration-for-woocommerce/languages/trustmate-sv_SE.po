msgstr "Företagsnamn"

msgid "Product"
msgstr "Produkt"

msgid "Name"
msgstr "Namn"

msgid "Description"
msgstr "Beskrivning"

msgid "Show badge with shop's grade"
msgstr "Visa märke med butikens betyg"

msgid "Show sliding out widget with shop's grade"
msgstr "Visa utskjutande widget med butikens betyg"

msgid "Non-invasive badge is glued to screen's edge and takes little space"
msgstr "Diskret märke placeras på skärmens kant och tar liten plats"

